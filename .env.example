# --- database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialliquid"

# --- hyperliquid ---
# mainnet by default. set to "testnet" for local development against hyperliquid testnet.
NEXT_PUBLIC_HL_NETWORK=mainnet
# builder wallet. hyperliquid only lets users approve a builder whose own perps account holds >= 100 USDC, so
# until that wallet is funded, leave these at the zero address (or set BUILDER_FEE_TENTHS_BP=0): the app then runs
# with no builder code at all, orders carry no builder field, and enabling trading needs one signature, not two.
BUILDER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000
# $SOLIQUID contract address shown as a copy pill in the landing hero; leave empty to hide it
NEXT_PUBLIC_TOKEN_CA=B4GbDpyWLAEsCzsdpL7eyAcX1NybXFocVnKLxV21pump
# builder fee in tenths of a basis point. 50 = 0.05% per side. max 100 (0.1%) on perps. 0 turns the builder code off.
BUILDER_FEE_TENTHS_BP=50
# optional: run the whole stack against a synthetic in-process exchange (no network). never set in prod.
HL_MOCK=false

# --- secrets (generate with: openssl rand -hex 32) ---
# 32-byte hex key, AES-256-GCM encryption of agent private keys at rest
AGENT_KEY_SECRET=
# signs the session cookie
SESSION_SECRET=
# mainnet invite gate. empty = open.
INVITE_CODE=

# --- wallet ---
NEXT_PUBLIC_WALLETCONNECT_ID=

# --- app ---
# public url, used for og images and share links
NEXT_PUBLIC_APP_URL=http://localhost:3000
# production: NEXT_PUBLIC_APP_URL=https://socialliquid.fun

# --- indexer ---
# info api weight budget per minute per ip (published limit is 1200). we stay under it.
HL_WEIGHT_BUDGET_PER_MIN=1000
# floor on per-address poll interval. real cadence is budget-bound with 200 addresses.
POLL_INTERVAL_MS=5000
# comma separated addresses to track when the leaderboard endpoint is unreachable
SEED_ADDRESSES=
# how many leaderboard addresses to seed
SEED_COUNT=200
# how many of hyperliquid's own leaderboard (30D) rows to mirror onto /leaderboard, and how often to refresh
# always-tracked traders on top of src/lib/featured.ts (comma separated, polled first)
PINNED_ADDRESSES=
HL_LEADERBOARD_TOP_N=100
# "portfolio" forces the board to be rebuilt from the portfolio api for the featured traders instead of the leaderboard feed
HL_LEADERBOARD_SOURCE=
HL_LEADERBOARD_REFRESH_MS=3600000

# --- keys (subscriptions + keys on HyperEVM) ---
# off (default): /keys is a preview on sample data and nothing is charged. on: real creators, payments and keys.
NEXT_PUBLIC_KEYS_LIVE=false
# Hyperliquid address that receives the platform's share (10%) of each subscription. empty: creators keep it all.
NEXT_PUBLIC_SUBS_TREASURY=
# the SocialLiquidKeys contract and USDC on HyperEVM, printed by `npm run deploy` in contracts/. empty: subscriptions
# work, keys show as "opening soon". the contract is unaudited: get it audited before it holds real money.
NEXT_PUBLIC_KEYS_CONTRACT=
NEXT_PUBLIC_KEYS_USDC=
# worker: where to read the contract from, and the deploy block so the first sync does not walk from genesis
HYPEREVM_RPC=https://rpc.hyperliquid.xyz/evm
# the browser's HyperEVM node for key trades; empty = the public one
NEXT_PUBLIC_HYPEREVM_RPC=
KEYS_START_BLOCK=
# payouts (pnpm keys:distribute): a HyperEVM wallet holding USDC + HYPE for the holder deposits, and the builder
# wallet's key for sending traders their share on Hyperliquid. set these on the machine that runs payouts only.
KEYS_DISTRIBUTOR_KEY=
BUILDER_PRIVATE_KEY=
