# --- database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialliquid"

# --- hyperliquid ---
# set to "true" for testnet (local dev). anything else = mainnet.
NEXT_PUBLIC_HL_TESTNET=true
# builder wallet. must hold >= 100 USDC perps account value on mainnet or orders with our code are rejected.
BUILDER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000
# builder fee in tenths of a basis point. 50 = 0.05% per side. max 100 (0.1%) on perps.
BUILDER_FEE_TENTHS_BP=50
# optional: run the whole stack against a synthetic in-process exchange (no network). never set in prod.
HL_MOCK=false

# --- secrets (generate with: openssl rand -hex 32) ---
# 32-byte hex key, AES-256-GCM encryption of agent private keys at rest
AGENT_KEY_SECRET=
# signs the session cookie
SESSION_SECRET=
# mainnet invite gate. empty = open.
INVITE_CODE=

# --- wallet ---
NEXT_PUBLIC_WALLETCONNECT_ID=

# --- app ---
# public url, used for og images and share links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- indexer ---
# info api weight budget per minute per ip (published limit is 1200). we stay under it.
HL_WEIGHT_BUDGET_PER_MIN=1000
# floor on per-address poll interval. real cadence is budget-bound with 200 addresses.
POLL_INTERVAL_MS=5000
# comma separated addresses to track when the leaderboard endpoint is unreachable
SEED_ADDRESSES=
# how many leaderboard addresses to seed
SEED_COUNT=200
